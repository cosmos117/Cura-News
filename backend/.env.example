# ===== Server =====
PORT=5000
NODE_ENV=development

# ===== Database =====
# Local MongoDB, or an Atlas connection string:
#   mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/cura-news
MONGO_URI=mongodb://localhost:27017/cura-news

# ===== JWT =====
# REQUIRED in production. Must be at least 32 characters and must NOT be the
# placeholder below - the server refuses to boot otherwise, because a publicly
# known signing key lets anyone forge a token for any account.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# ===== AI providers =====
# AI calls go through generateStructured: GEMINI primary, GROQ fallback
# (see AI_PROVIDER). At least one of the two keys is required for AI features.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Which provider is tried first: gemini (default) or groq.
AI_PROVIDER=gemini

# ===== CORS =====
# Comma-separated list of allowed origins. Must match the frontend origin
# (http://localhost:3000 in dev).
CORS_ORIGIN=http://localhost:3000

# ===== Optional =====
# Set to false to disable the per-minute AI endpoint rate limit while
# developing locally. Do not disable in production: every call is billed.
RATE_LIMIT_AI=true

# ===== Ingestion scheduler =====
# How often the background pipeline fetches new articles, in minutes.
# This is what keeps the dashboard populated all day: without it, nothing
# refetches automatically and the UTC day window empties at midnight.
# Set to a large value to reduce automatic ingestion frequency.
INGEST_INTERVAL_MINUTES=15
CRON_SECRET=
TRUST_PROXY=1
MIN_ARTICLES_BEFORE_CLEANUP=5

# ===== Detailed summaries =====
DETAILED_TOP_N=30
MIN_TEXT_CHARS=800
INPUT_MAX_CHARS=12000
AI_DAILY_LIMIT=100
AI_DELAY_MS=500
FETCH_TIMEOUT_MS=10000